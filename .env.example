# Public site origin (no trailing slash) — used for canonical URLs, Open Graph, and sitemap/robots generation.
VITE_SITE_URL=https://www.example.com

# Backend API base (see README)
VITE_API_URL=http://localhost:5000/api

# Optional Twitter @handle for twitter:site (omit @ in value)
# VITE_TWITTER_SITE=eyelens

# Comma-separated profile URLs for Organization schema sameAs (Instagram, Facebook, YouTube, etc.)
# VITE_SITE_SAME_AS=https://www.instagram.com/yourbrand,https://www.facebook.com/yourbrand

# Razorpay public key (safe for frontend)
VITE_RAZORPAY_KEY_ID=
